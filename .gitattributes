# Normalize line endings across platforms so `ruff format --check`
# stays consistent between Linux/macOS runners and Windows runners.
* text=auto eol=lf

# Keep Windows shell scripts as CRLF where it matters.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary files — never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.wav       binary
*.bin       binary
*.so        binary
*.dylib     binary
*.dll       binary
*.onnx      binary
*.gguf      binary
*.npy       binary
